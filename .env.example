# SQLite by default. For Postgres set provider = "postgresql" in prisma/schema.prisma
# and use a postgres URL. See docs/DEPLOYMENT.md.
DATABASE_URL="file:./dev.db"

# Auth.js secret. Generated on first setup if absent. Staff login only.
AUTH_SECRET="replace-with-a-long-random-string"

APP_URL="http://localhost:3000"

# Demo mode is forced on when no LLM key is present.
DEMO_MODE="true"

# gemini | openai_compat | anthropic | none
LLM_PROVIDER="none"
LLM_MODEL=""

GEMINI_API_KEY=""
OPENAI_COMPAT_BASE_URL=""
OPENAI_COMPAT_API_KEY=""
ANTHROPIC_API_KEY=""

# browser | bhashini | sarvam
SPEECH_PROVIDER="browser"
BHASHINI_API_KEY=""
BHASHINI_USER_ID=""
SARVAM_API_KEY=""

SEED_ADMIN_PASSWORD="nourish-demo-admin"
RETENTION_DAYS="90"
K_ANON_MIN="10"
MIN_COHORT="20"
