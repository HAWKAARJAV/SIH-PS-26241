{
  "name": "nourish",
  "version": "1.0.0",
  "private": true,
  "description": "Nourish — AI-enabled career counselling and family decision-support for vocational education. SIH 2026 prototype.",
  "license": "MIT",
  "scripts": {
    "setup": "test -f .env || cp .env.example .env; prisma generate && prisma db push --skip-generate && tsx prisma/seed/index.ts",
    "clean": "rm -rf .next",
    "dev": "next dev",
    "dev:clean": "npm run clean && npm run dev",
    "demo": "next dev",
    "build": "prisma generate && next build",
    "start": "node scripts/start-standalone.mjs",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "a11y": "playwright test --config playwright.a11y.config.ts",
    "lighthouse": "node scripts/lighthouse.mjs",
    "eval": "tsx src/ai/eval/run.ts",
    "contrast": "tsx scripts/contrast-check.ts",
    "i18n:check": "tsx scripts/i18n-check.ts",
    "bundle:check": "tsx scripts/bundle-check.ts",
    "seed": "tsx prisma/seed/index.ts",
    "seed:analytics": "tsx prisma/seed/analytics.ts",
    "audio:generate": "tsx scripts/audio-generate.ts",
    "docker:up": "docker compose up --build",
    "postinstall": "prisma generate",
    "verify": "npm run setup && npm run contrast && npm run i18n:check && npm run typecheck && npm run lint && npm run test && npm run eval && npm run build && npm run bundle:check"
  },
  "prisma": {
    "seed": "tsx prisma/seed/index.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.22",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.544.0",
    "minisearch": "^7.1.2",
    "next": "^15.5.4",
    "next-auth": "^5.0.0-beta.29",
    "next-intl": "^4.3.9",
    "papaparse": "^5.5.3",
    "pino": "^9.11.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^3.2.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.5.2",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@eslint/eslintrc": "^3.3.1",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.4",
    "prisma": "^6.16.2",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
